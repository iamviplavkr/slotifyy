<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= BASE THEME ================= -->
    <style name="Theme.Slotify" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/yellow_primary</item>
        <item name="colorPrimaryVariant">@color/yellow_dark</item>
        <item name="colorOnPrimary">@color/black_primary</item>

        <item name="colorSecondary">@color/yellow_primary</item>
        <item name="colorOnSecondary">@color/black_primary</item>

        <item name="android:windowBackground">@color/black_primary</item>
        <item name="android:statusBarColor">@color/black_primary</item>
        <item name="android:navigationBarColor">@color/black_primary</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>

    <!-- ================= SPLASH THEME ================= -->
    <style name="Theme.Slotify.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/black_primary</item>

    </style>

    <!-- ================= DATE PICKER ================= -->
    <style name="SlotifyDatePicker" parent="Theme.MaterialComponents.DayNight.Dialog">

        <item name="colorPrimary">@color/yellow_primary</item>
        <item name="colorOnPrimary">@color/black_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/surface_card</item>

    </style>

    <!-- ================= TIME PICKER ================= -->
    <style name="SlotifyTimePicker" parent="Theme.MaterialComponents.DayNight.Dialog">

        <item name="colorPrimary">@color/yellow_primary</item>
        <item name="colorOnPrimary">@color/black_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/surface_card</item>

    </style>

</resources>