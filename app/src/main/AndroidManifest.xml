<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.viplavkr.slotify">

    <!-- ================= PERMISSIONS ================= -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Camera Feature (optional) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <!-- ================= APPLICATION ================= -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slotify">

        <!-- ================= SPLASH ================= -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Slotify.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- ================= AUTH ================= -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.SignupActivity"
            android:exported="false"/>

        <!-- ================= USER ================= -->
        <activity
            android:name=".user.activities.MainActivity"
            android:exported="false"/>

        <activity
            android:name=".user.activities.SlotsActivity"
            android:exported="false"/>

        <activity
            android:name=".user.activities.PaymentActivity"
            android:exported="false"/>

        <activity
            android:name=".user.activities.ConfirmationActivity"
            android:exported="false"/>

        <activity
            android:name=".user.activities.ScannerActivity"
            android:exported="false"/>

        <!-- ================= ADMIN ================= -->
        <activity
            android:name=".admin.activities.AdminDashboardActivity"
            android:exported="false"/>

        <activity
            android:name=".admin.activities.BookingsViewActivity"
            android:exported="false"/>

        <activity
            android:name=".admin.activities.SlotsManagementActivity"
            android:exported="false"/>

        <activity
            android:name=".admin.activities.UsersManagementActivity"
            android:exported="false"/>

        <activity
            android:name=".admin.activities.LocationsManagementActivity"
            android:exported="false"/>

        <activity
            android:name=".admin.activities.RevenueActivity"
            android:exported="false"/>

    </application>

</manifest>
